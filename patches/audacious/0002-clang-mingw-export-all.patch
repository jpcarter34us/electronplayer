Build with clang on Windows by exporting every symbol

Clang (llvm-mingw) rejects __declspec(dllexport) on a definition whose
earlier declaration lacks it, which GCC accepts and Audacious relies on.
With clang on Windows, define EXPORT as nothing, link with
--export-all-symbols, and drop -fvisibility=hidden (lld leaves hidden
symbols out of the export-all set). GCC and other platforms are unchanged.

diff --git a/meson.build b/meson.build
index 8088278..93c694a 100644
--- a/meson.build
+++ b/meson.build
@@ -85,6 +85,13 @@ if cc.get_id() in ['gcc', 'clang']
     '-fvisibility-inlines-hidden'
   ]
 
+  # Clang on Windows exports every symbol (see EXPORT below), and lld leaves
+  # hidden ones out of that.
+  if have_windows and cc.get_id() == 'clang'
+    common_flags = ['-ffast-math', '-Wtype-limits', '-Wno-stringop-truncation']
+    cxx_flags = ['-Wno-non-virtual-dtor', '-Woverloaded-virtual']
+  endif
+
   check_cflags = common_flags
   check_cxxflags = common_flags + cxx_flags
 
@@ -122,7 +129,12 @@ else
 endif
 
 
-if have_windows
+if have_windows and cxx.get_id() == 'clang'
+  # Clang (llvm-mingw) rejects dllexport on a definition whose earlier
+  # declaration lacks it, which GCC accepts; export every symbol instead.
+  conf.set('EXPORT', '')
+  add_project_link_arguments('-Wl,--export-all-symbols', language: ['c', 'cpp'])
+elif have_windows
   conf.set('EXPORT', '__declspec(dllexport)')
 elif cxx.has_argument('-fvisibility=default')
   conf.set('EXPORT', '__attribute__((visibility("default")))')
